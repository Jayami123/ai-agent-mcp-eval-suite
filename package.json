{
  "name": "ai-agent-mcp-eval-suite",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Evaluation suite for AI agents and MCP tool use, built on qa-portfolio-harness.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\" \"dist-test/**/*.e2e.js\"",
    "test:nightly": "tsc -p tsconfig.test.json && node --test dist-test/tests/l1/gemma-tool-call.e2e.js",
    "check": "npm run typecheck && npm test && npm run build",
    "stub": "node dist/stub/main.js",
    "stub:up": "node scripts/stub-container.mjs up",
    "stub:down": "node scripts/stub-container.mjs down",
    "lab": "node dist/attack-lab/main.js",
    "lab:up": "node scripts/lab-container.mjs up",
    "lab:down": "node scripts/lab-container.mjs down",
    "test:lab:conformance": "tsc -p tsconfig.test.json && P4_LAB_CONFORMANCE=1 node --test --test-timeout=600000 dist-test/tests/l2/conformance.e2e.js",
    "test:stack:librechat": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 dist-test/tests/l1/librechat-stub-tool-call.e2e.js",
    "test:stack:openclaw": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 dist-test/tests/l1/openclaw-stub-tool-call.e2e.js",
    "test:stack:l3:twenty": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/twenty/run.e2e.js",
    "test:stack:l3:nextcloud": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/nextcloud/run.e2e.js",
    "test:stack:l3:penpot": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/penpot/run.e2e.js",
    "test:stack:l3:nextcloud:appr-deny": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/nextcloud/appr-deny.e2e.js",
    "test:stack:l3:nextcloud:appr-ask": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/nextcloud/appr-ask.e2e.js",
    "l4:up": "node scripts/l4-stack.mjs up",
    "l4:down": "node scripts/l4-stack.mjs down",
    "test:stack:l4": "tsc -p tsconfig.test.json && P4_STACK_TESTS=1 P4_L4_STACK=1 P4_L4_CHANNEL=1 P4_L4_PRIVATE_FETCH=1 node --test --test-concurrency=1 --test-timeout=1200000 \"dist-test/tests/l4/**/*.e2e.js\"",
    "test:stack:l3:host": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/host/run.e2e.js",
    "test:stack:l3:lab-gates": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/host/gates-noappr.e2e.js dist-test/tests/l3/host/gates-appr.e2e.js",
    "test:stack:l3:lab-std": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/host/lab-std.e2e.js",
    "test:stack:l3:lab-matrix": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/host/lab-matrix.e2e.js",
    "test:stack:l3:lab-schema": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/host/lab-schema.e2e.js",
    "test:stack:l3:always-allow": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/host/always-allow.e2e.js",
    "test:stack:l3:mattermost": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/mattermost/run.e2e.js",
    "test:stack:l3:mattermost:measured": "tsc -p tsconfig.test.json && node --test --test-timeout=21600000 --test-concurrency=1 dist-test/tests/l3/mattermost/measured.e2e.js",
    "test:stack:l3:outline": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/outline/run.e2e.js",
    "test:stack:l3:lab-typo": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/host/lab-typo.e2e.js",
    "test:stack:l3:probe:mail": "tsc -p tsconfig.test.json && P4_L3_PROBE=1 node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/probe/mail.e2e.js",
    "test:stack:l3:probe:ui": "tsc -p tsconfig.test.json && P4_L3_PROBE=1 node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/probe/ui.e2e.js",
    "test:stack:l3:ui": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/host/ui.e2e.js",
    "test:stack:l3:mail": "tsc -p tsconfig.test.json && node --test --test-timeout=2400000 --test-concurrency=1 dist-test/tests/l3/nextcloud/mail.e2e.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "qa-portfolio-harness": "github:Jayami123/qa-portfolio-harness#v0.6.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/conformance": "0.1.16",
    "@types/node": "^22.13.10",
    "ajv": "8.20.0",
    "p4-conformance-2026": "npm:@modelcontextprotocol/conformance@0.2.0-alpha.12",
    "playwright": "1.63.0",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "github:Jayami123/qa-portfolio-harness#v0.6.10": true
  }
}
