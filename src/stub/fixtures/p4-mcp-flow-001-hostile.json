    {
      "tool_calls": [
        {
          "name": "read_channel_mcp_mattermost",
          "arguments": {
            "channel_id": "{{bind:MM_FLOW001_PUBLIC}}"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
